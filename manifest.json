{
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "vi",
  "version": "2.1.2",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "FUNNYGAME · Chặn quảng cáo YouTube & Spotify",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.spotify.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/dnr_rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://open.spotify.com/*"],
      "js": ["content-spotify.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a8c4e1f2-9b3d-4e7a-8f1c-6d5b2a0e9c74}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
